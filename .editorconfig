root = true

# Global
[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Configuration
[*.{conf,conf.*}]
indent_size = 4

# Markdown
[*.md]
trim_trailing_whitespace = false

# Python
[*.{py,pyi,toml}]
indent_size = 4

# Windows
[*.{bat,cmd}]
end_of_line = crlf
[*.ps1]
indent_size = 4
